-- ==================== FRUIT NOTIFIER ====================
local function FruitNotifierLoop()
    local notifiedFruits = {}
    
    while Settings.FruitNotifier do
        for _, item in pairs(workspace:GetDescendants()) do
            if item:IsA("Tool") and item:FindFirstChild("Handle") and IsFruit(item) then
                if not notifiedFruits[item] then
                    notifiedFruits[item] = true
                    local distance = (rootPart.Position - item.Handle.Position).Magnitude
                    CreateNotification(
                        "🍎 FRUTA ENCONTRADA!", 
                        item.Name .. " à " .. math.floor(distance) .. " studs de distância",
                        5
                    )
                    
                    -- Teleportar automaticamente se ativado
                    if Settings.AutoCollect then
                        rootPart.CFrame = CFrame.new(item.Handle.Position)
                    end
                end
            end
        end
        wait(1)
    end
end

-- ==================== ANTI-AFK ====================
local function AntiAFKLoop()
    local lastPos = rootPart.Position
    local lastTime = tick()
    
    while Settings.AntiAFK do
        if (rootPart.Position - lastPos).Magnitude < 1 and tick() - lastTime > 60 then
            -- Mover levemente
            rootPart.CFrame = rootPart.CFrame * CFrame.new(1, 0, 1)
            lastPos = rootPart.Position
            lastTime = tick()
        else
            lastPos = rootPart.Position
            lastTime = tick()
        end
        wait(30)
    end
end

