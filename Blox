-- ==================== TELEPORTE ====================
local function TeleportTo(island)
    if not rootPart then return false end
    
    local targetPos = island.pos
    local distance = (rootPart.Position - targetPos).Magnitude
    
    if distance > 50 then
        rootPart.CFrame = CFrame.new(targetPos)
        wait(0.3)
        CreateNotification("Teleporte", "Teleportado para: " .. island.name, 2)
        return true
    end
    return false
end

local function TeleportToNPC(npcName)
    for _, npc in pairs(workspace.Enemies:GetChildren()) do
        if npc.Name:lower():find(npcName:lower()) and npc:FindFirstChild("HumanoidRootPart") then
            rootPart.CFrame = CFrame.new(npc.HumanoidRootPart.Position + Vector3.new(0, 3, 5))
            return true
        end
    end
    return false
end

-- ==================== AUTO FARM ====================
local function GetNearestEnemy()
    local nearest = nil
    local shortestDist = math.huge
    
    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
        local enemyHumanoid = enemy:FindFirstChild("Humanoid")
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
        
        if enemyHumanoid and enemyHumanoid.Health > 0 and enemyRoot then
            local dist = (rootPart.Position - enemyRoot.Position).Magnitude
            if dist < shortestDist and dist < Settings.AutoFarmRange then
                shortestDist = dist
                nearest = enemy
            end
        end
    end
    return nearest
end

local function AttackEnemy(enemy)
    if not enemy or not enemy:FindFirstChild("HumanoidRootPart") then return end
    
    local args = {
        [1] = enemy.HumanoidRootPart.Position,
        [2] = enemy
    }
    
    local combatRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if combatRemote and combatRemote:FindFirstChild("Combat") then
        combatRemote.Combat:FireServer(unpack(args))
    end
end

local function AutoFarmLoop()
    while Settings.AutoFarm do
        local target = GetNearestEnemy()
        
        if target then
            local targetRoot = target.HumanoidRootPart
            rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 4)
            AttackEnemy(target)
        end
        
        wait(0.1)
    end
end

-- ==================== AUTO QUEST ====================
local function GetCurrentQuest()
    local questGUI = LocalPlayer.PlayerGui:FindFirstChild("Main")
    if questGUI and questGUI:FindFirstChild("Quest") then
        return questGUI.Quest
    end
    return nil
end

local function CompleteQuest()
    local completeRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if completeRemote and completeRemote:FindFirstChild("CompleteQuest") then
        completeRemote.CompleteQuest:FireServer()
        CreateNotification("Quest", "Quest completada!", 1)
    end
end

local function AcceptQuest(questName)
    local questRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if questRemote and questRemote:FindFirstChild("Quest") then
        questRemote.Quest:FireServer(questName)
        CreateNotification("Quest", "Quest aceita: " .. questName, 1)
    end
end

local function AutoQuestLoop()
    while Settings.AutoQuest do
        local quest = GetCurrentQuest()
        
        if quest and quest.Visible then
            -- Verificar se completou
            local questComplete = quest:FindFirstChild("QuestComplete")
            if questComplete and questComplete.Visible then
                CompleteQuest()
            end
        end
        
        wait(Settings.AutoQuestDelay)
    end
end

-- ==================== AUTO COLLECT FRUIT ====================
local function IsFruit(item)
    local name = item.Name:lower()
    local fruits = {"fruit", "dragon", "leopard", "dough", "spirit", "venom", 
                    "shadow", "control", "buddha", "rumble", "magma", "light", 
                    "ice", "flame", "dark", "quake"}
    
    for _, fruit in ipairs(fruits) do
        if name:find(fruit) then
            return true
        end
    end
    return false
end

local function GetNearestCollectable()
    local nearest = nil
    local shortestDist = math.huge
    
    for _, item in pairs(workspace:GetDescendants()) do
        if item:IsA("Tool") and item:FindFirstChild("Handle") then
            local isCollectable = false
            
            if Settings.AutoCollectFruits and IsFruit(item) then
                isCollectable = true
            end
            
            if Settings.AutoCollectChests and item.Name:lower():find("chest") then
                isCollectable = true
            end
            
            if isCollectable then
                local dist = (rootPart.Position - item.Handle.Position).Magnitude
                if dist < shortestDist and dist < Settings.AutoCollectRange then
                    shortestDist = dist
                    nearest = item
                end
            end
        end
    end
    return nearest
end

local function AutoCollectLoop()
    while Settings.AutoCollect do
        local item = GetNearestCollectable()
        
        if item and item:FindFirstChild("Handle") then
            rootPart.CFrame = CFrame.new(item.Handle.Position)
            wait(0.3)
            CreateNotification("Coleta", "Coletando: " .. item.Name, 0.5)
        end
        
        wait(0.5)
    end
end

-- ==================== ESP (WALLHACK) ====================
local function AddESP(obj, text, color, icon)
    if obj:FindFirstChild("BloxESP") then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BloxESP"
    billboard.Size = UDim2.new(0, 180, 0, 45)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = obj
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.5
    frame.Parent = billboard
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0.7, 0)
    label.Position = UDim2.new(0, 0, 0.15, 0)
    label.BackgroundTransparency = 1
    label.Text = (icon or "📍") .. " " .. text
    label.TextColor3 = color
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = frame
    
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, 0, 0.3, 0)
    distanceLabel.Position = UDim2.new(0, 0, 0.7, 0)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = ""
    distanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distanceLabel.TextScaled = true
    distanceLabel.Font = Enum.Font.Gotham
    distanceLabel.Parent = frame
    
    -- Atualizar distância
    spawn(function()
        while obj and obj.Parent and billboard.Parent do
            local distance = (rootPart.Position - obj:GetPivot().Position).Magnitude
            distanceLabel.Text = string.format("%.1f studs", distance)
            wait(0.5)
        end
    end)
    
    return billboard
end

local function ESPLoop()
    while Settings.ESP do
        -- ESP para Frutas
        if Settings.ESPFruits then
            for _, item in pairs(workspace:GetDescendants()) do
                if item:IsA("Tool") and item:FindFirstChild("Handle") and IsFruit(item) then
                    AddESP(item, item.Name, Color3.fromRGB(255, 100, 100), "🍎")
                end
            end
        end
        
        -- ESP para NPCs/Mobs
        if Settings.ESPMobs then
            for _, mob in pairs(workspace.Enemies:GetChildren()) do
                if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                    local color = Color3.fromRGB(255, 50, 50)
                    if mob.Name:lower():find("boss") then
                        color = Color3.fromRGB(255, 150, 0)
                    end
                    AddESP(mob, mob.Name, color, "👹")
                end
            end
        end
        
        -- ESP para Players
        if Settings.ESPPlayers then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local playerRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if playerRoot then
                        local color = Color3.fromRGB(100, 150, 255)
                        if player.Team == LocalPlayer.Team then
                            color = Color3.fromRGB(100, 255, 100)
                        end
                        AddESP(player.Character, player.Name, color, "👤")
                    end
                end
            end
        end
        
        wait(2)
    end
    
    -- Limpar ESP quando desativado
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") and v.Name == "BloxESP" then
            v:Destroy()
        end
    end
end

